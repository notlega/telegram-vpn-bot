# Copy to .env and fill in. Bun loads .env automatically.
# Push to Cloudflare with: bun run secrets

# Telegram bot token from @BotFather
BOT_TOKEN=

# linode api token: https://cloud.linode.com/profile/tokens
LINODE_API_TOKEN=

# Random string; must match the webhook secret_token registered with Telegram
WEBHOOK_SECRET=
