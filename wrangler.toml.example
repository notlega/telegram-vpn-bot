# copy this file to wrangler.toml and fill in the kv namespace id
# the binding name stays "KV": the code (env.KV) and the local test
# commands in the readme reference it

name = "telegram-vpn-bot"
main = "src/index.ts"
compatibility_date = "2026-01-01"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[observability]
enabled = true

[triggers]
crons = ["*/2 * * * *"]

[[kv_namespaces]]
binding = "KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
SNI = "www.yahoo.com"
REGIONS = "jp-tyo-3:Tokyo,jp-osa:Osaka,sg-sin-2:Singapore"
TYPE = "g6-nanode-1"
IMAGE = "linode/debian13"

[[migrations]]
tag = "v2"
deleted_classes = ["Gatekeeper"]
