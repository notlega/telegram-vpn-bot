{
  "name": "telegram-vpn-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serverless Telegram bot that provisions VLESS+REALITY proxy servers on Vultr",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint",
    "set-webhook": "bun scripts/set-webhook.ts",
    "secrets": "bun scripts/secrets.ts"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  }
}
