{
  "name": "telegram-vpn-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serverless Telegram bot that provisions VLESS + REALITY proxy servers on Vultr",
  "scripts": {
    "check": "bun run typecheck && bun run lint",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "secrets": "bun scripts/secrets.ts",
    "set-webhook": "bun scripts/set-webhook.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "grammy": "^1.48.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/bun": "^1.4.5",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
